PORT=4000
CORS_ORIGIN=http://localhost:3000

# TON Center v3 — sole blockchain data provider (X-API-Key header)
TON_CENTER_BASE_URL=https://toncenter.com/api/v3
TON_API_KEY=your_toncenter_v3_api_key_from_tonapibot

# Tiered cache TTLs (milliseconds)
WALLET_ANALYSIS_CACHE_TTL_MS=60000
OPPORTUNITY_RANKINGS_CACHE_TTL_MS=120000
STONFI_CACHE_TTL_MS=600000
ACTIONS_CACHE_TTL_MS=300000
ACTIONS_FETCH_LIMIT=10
ENABLE_DEBUG_LOGS=false
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3

# Mira Track — Telegram workflow
MIRA_TELEGRAM_URL=https://t.me/mira

# STON.fi DEX API (live pool APY, TVL, liquidity)
STONFI_API_URL=https://api.ston.fi
STONFI_APP_URL=https://app.ston.fi

# Tonstakers liquid staking APY (tonapi.io — same source as tonstakers-sdk getCurrentApy)
TONAPI_BASE_URL=https://tonapi.io
TONSTAKERS_POOL_ADDRESS=EQCkWxfyhAkim3g2DjKQQg8T5P4g-Q1-K_jErGcDJZ4i-vqR
TONSTAKERS_CACHE_TTL_MS=300000

# Future STON.fi Omniston integration
